{
  "name": "gigawatts-cache-purge",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "121gigawatts.org/.well-known/ghost-cache-purge",
      "zone_name": "121gigawatts.org"
    }
  ]
}
