{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private storage for immutable forecast inputs and dataset outputs",
  "Resources": {
    "ForecastStorage": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [{"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]
        },
        "VersioningConfiguration": {"Status": "Enabled"},
        "LifecycleConfiguration": {
          "Rules": [{"Id": "AbortIncompleteUploads", "Status": "Enabled", "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 7}}]
        },
        "Tags": [{"Key": "Project", "Value": "coppersushi-forecasts"}]
      }
    },
    "RequireTLS": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "ForecastStorage"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
              {"Fn::GetAtt": ["ForecastStorage", "Arn"]},
              {"Fn::Sub": "${ForecastStorage.Arn}/*"}
            ],
            "Condition": {"Bool": {"aws:SecureTransport": "false"}}
          }]
        }
      }
    }
  },
  "Outputs": {"BucketName": {"Value": {"Ref": "ForecastStorage"}}}
}
