{
  "$defs": {
    "BindingRow": {
      "additionalProperties": false,
      "description": "One physical binding publication with its country sensitivities.",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "integer"
        },
        "eic": {
          "pattern": "^[A-Z0-9-]{16}$",
          "title": "Eic",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "contingency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Contingency"
        },
        "shadow_price": {
          "title": "Shadow Price",
          "type": "number"
        },
        "ram": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ram"
        },
        "capacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity"
        },
        "geometry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometry"
        },
        "ptdfs": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "AT",
              "BE",
              "CZ",
              "DE",
              "FR",
              "HR",
              "HU",
              "NL",
              "PL",
              "RO",
              "SI",
              "SK"
            ]
          },
          "title": "Ptdfs",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "eic",
        "name",
        "direction",
        "contingency",
        "shadow_price",
        "ram",
        "capacity",
        "geometry",
        "ptdfs"
      ],
      "title": "BindingRow",
      "type": "object"
    },
    "CountryCap": {
      "additionalProperties": false,
      "description": "Inferred Polish cap and its signed effect on the Polish price.",
      "properties": {
        "source_id": {
          "enum": [
            -1,
            -2
          ],
          "title": "Source Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "capacity": {
          "title": "Capacity",
          "type": "number"
        },
        "shadow_price": {
          "title": "Shadow Price",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "name",
        "direction",
        "capacity",
        "shadow_price",
        "delta"
      ],
      "title": "CountryCap",
      "type": "object"
    },
    "DayBundle": {
      "additionalProperties": false,
      "description": "Producer-side complete day; browser delivery uses separate interval objects.",
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/ZoneGeometry"
          },
          "title": "Zones",
          "type": "array"
        },
        "elements": {
          "additionalProperties": {
            "$ref": "#/$defs/ElementGeometry"
          },
          "title": "Elements",
          "type": "object"
        },
        "price_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Price Range",
          "type": "array"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/MarketInterval"
          },
          "title": "Intervals",
          "type": "array"
        }
      },
      "required": [
        "day",
        "labels",
        "zones",
        "elements",
        "price_range",
        "intervals"
      ],
      "title": "DayBundle",
      "type": "object"
    },
    "DayManifest": {
      "additionalProperties": false,
      "description": "Atomic pointer to a complete immutable generation of a prepared day.",
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "generation": {
          "pattern": "^[0-9a-f]{24}$",
          "title": "Generation",
          "type": "string"
        }
      },
      "required": [
        "day",
        "generation"
      ],
      "title": "DayManifest",
      "type": "object"
    },
    "DayMetadata": {
      "additionalProperties": false,
      "description": "Versioned, token-free data for all interactions within a delivery day.",
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/ZoneGeometry"
          },
          "title": "Zones",
          "type": "array"
        },
        "elements": {
          "additionalProperties": {
            "$ref": "#/$defs/ElementGeometry"
          },
          "title": "Elements",
          "type": "object"
        },
        "price_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Price Range",
          "type": "array"
        }
      },
      "required": [
        "day",
        "labels",
        "zones",
        "elements",
        "price_range"
      ],
      "title": "DayMetadata",
      "type": "object"
    },
    "ElementGeometry": {
      "additionalProperties": false,
      "description": "Resolved physical element in its publisher's orientation.",
      "properties": {
        "branch_id": {
          "title": "Branch Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "line",
            "transformer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "endpoints": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Endpoints",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "kind",
        "endpoints"
      ],
      "title": "ElementGeometry",
      "type": "object"
    },
    "MarketInterval": {
      "additionalProperties": false,
      "description": "Published values for one UTC interval, labelled in market local time.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prices": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "AT",
              "BE",
              "CZ",
              "DE",
              "FR",
              "HR",
              "HU",
              "NL",
              "PL",
              "RO",
              "SI",
              "SK"
            ]
          },
          "title": "Prices",
          "type": "object"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/BindingRow"
          },
          "title": "Constraints",
          "type": "array"
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alpha"
        },
        "caps": {
          "items": {
            "$ref": "#/$defs/CountryCap"
          },
          "title": "Caps",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "index",
        "label",
        "prices",
        "constraints",
        "alpha",
        "caps",
        "notes"
      ],
      "title": "MarketInterval",
      "type": "object"
    },
    "ZoneGeometry": {
      "additionalProperties": false,
      "description": "Display boundary and interior label anchor shared by every interval.",
      "properties": {
        "zone": {
          "enum": [
            "AT",
            "BE",
            "CZ",
            "DE",
            "FR",
            "HR",
            "HU",
            "NL",
            "PL",
            "RO",
            "SI",
            "SK"
          ],
          "title": "Zone",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rings": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "title": "Rings",
          "type": "array"
        },
        "centre": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Centre",
          "type": "array"
        }
      },
      "required": [
        "zone",
        "name",
        "rings",
        "centre"
      ],
      "title": "ZoneGeometry",
      "type": "object"
    }
  },
  "properties": {
    "bundle": {
      "$ref": "#/$defs/DayBundle"
    },
    "metadata": {
      "$ref": "#/$defs/DayMetadata"
    },
    "interval": {
      "$ref": "#/$defs/MarketInterval"
    },
    "manifest": {
      "$ref": "#/$defs/DayManifest"
    }
  },
  "required": [
    "bundle",
    "metadata",
    "interval",
    "manifest"
  ],
  "title": "CnecContracts",
  "type": "object"
}
