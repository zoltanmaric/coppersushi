{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "AttributionPayload": {
      "additionalProperties": false,
      "description": "Successfully loaded price-attribution inputs for one browser request.",
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AttributionRow"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "day",
        "complete",
        "rows"
      ],
      "title": "AttributionPayload",
      "type": "object"
    },
    "AttributionRow": {
      "additionalProperties": false,
      "description": "Inputs for explaining why electricity prices differ between bidding zones.\n\nAttribution calculates how much each binding grid or import/export limit\ncontributes to that price difference, in EUR/MWh. This row holds the scaling\nfactor and Polish cap inputs for one market interval, encoded as browser JSON.\nNull means an input is unavailable.\n\nSee wiki/flow-based-market-coupling.md#attribution for an example and limits.",
      "properties": {
        "interval": {
          "format": "date-time",
          "title": "Interval",
          "type": "string"
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alpha"
        },
        "import_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Import Limit"
        },
        "export_limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Export Limit"
        },
        "polish_position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Polish Position"
        },
        "polish_alt": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Polish Alt"
        }
      },
      "required": [
        "interval",
        "alpha",
        "import_limit",
        "export_limit",
        "polish_position",
        "polish_alt"
      ],
      "title": "AttributionRow",
      "type": "object"
    },
    "BindingRow": {
      "additionalProperties": false,
      "description": "One physical binding publication with its country sensitivities.",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "contingency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Contingency"
        },
        "shadow_price": {
          "title": "Shadow Price",
          "type": "number"
        },
        "ram": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ram"
        },
        "capacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capacity"
        },
        "geometry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometry"
        },
        "ptdfs": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "AT",
              "BE",
              "CZ",
              "DE",
              "FR",
              "HR",
              "HU",
              "NL",
              "PL",
              "RO",
              "SI",
              "SK"
            ]
          },
          "title": "Ptdfs",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "name",
        "direction",
        "contingency",
        "shadow_price",
        "ram",
        "capacity",
        "geometry",
        "ptdfs"
      ],
      "title": "BindingRow",
      "type": "object"
    },
    "ConstraintOption": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "source": {
          "enum": [
            "constraints",
            "attribution"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value",
        "source"
      ],
      "title": "ConstraintOption",
      "type": "object"
    },
    "CountryCap": {
      "additionalProperties": false,
      "description": "Inferred Polish cap and its signed effect on the Polish price.",
      "properties": {
        "source_id": {
          "enum": [
            -1,
            -2
          ],
          "title": "Source Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "capacity": {
          "title": "Capacity",
          "type": "number"
        },
        "shadow_price": {
          "title": "Shadow Price",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "name",
        "direction",
        "capacity",
        "shadow_price",
        "delta"
      ],
      "title": "CountryCap",
      "type": "object"
    },
    "DayBundle": {
      "additionalProperties": false,
      "description": "Versioned, token-free data for all interactions within a delivery day.",
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/ZoneGeometry"
          },
          "title": "Zones",
          "type": "array"
        },
        "elements": {
          "additionalProperties": {
            "$ref": "#/$defs/ElementGeometry"
          },
          "title": "Elements",
          "type": "object"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/MarketInterval"
          },
          "title": "Intervals",
          "type": "array"
        },
        "price_range": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Price Range",
          "type": "array"
        }
      },
      "required": [
        "day",
        "labels",
        "zones",
        "elements",
        "intervals",
        "price_range"
      ],
      "title": "DayBundle",
      "type": "object"
    },
    "DayManifest": {
      "additionalProperties": false,
      "description": "Atomic pointer to a complete immutable generation of a prepared day.",
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "generation": {
          "pattern": "^[0-9a-f]{24}$",
          "title": "Generation",
          "type": "string"
        }
      },
      "required": [
        "day",
        "generation"
      ],
      "title": "DayManifest",
      "type": "object"
    },
    "DayResponse": {
      "additionalProperties": false,
      "description": "Market-time-unit labels computed in the market timezone, including DST folds.",
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "day",
        "labels"
      ],
      "title": "DayResponse",
      "type": "object"
    },
    "ElementGeometry": {
      "additionalProperties": false,
      "description": "Resolved physical element in its publisher's orientation.",
      "properties": {
        "branch_id": {
          "title": "Branch Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "line",
            "transformer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "endpoints": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Endpoints",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "kind",
        "endpoints"
      ],
      "title": "ElementGeometry",
      "type": "object"
    },
    "JsonValue": {},
    "LayerResponse": {
      "additionalProperties": false,
      "description": "One ready visual layer scoped to the exact view that requested it.",
      "properties": {
        "request": {
          "$ref": "#/$defs/ViewRequest"
        },
        "figure": {
          "$ref": "#/$defs/PlotlyFigure"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ConstraintOption"
          },
          "title": "Options",
          "type": "array"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reference"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "request",
        "figure",
        "options",
        "reference",
        "notes"
      ],
      "title": "LayerResponse",
      "type": "object"
    },
    "MarketInterval": {
      "additionalProperties": false,
      "description": "Published values for one UTC interval, labelled in market local time.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "prices": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "AT",
              "BE",
              "CZ",
              "DE",
              "FR",
              "HR",
              "HU",
              "NL",
              "PL",
              "RO",
              "SI",
              "SK"
            ]
          },
          "title": "Prices",
          "type": "object"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/BindingRow"
          },
          "title": "Constraints",
          "type": "array"
        },
        "alpha": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Alpha"
        },
        "caps": {
          "items": {
            "$ref": "#/$defs/CountryCap"
          },
          "title": "Caps",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "index",
        "label",
        "prices",
        "constraints",
        "alpha",
        "caps",
        "notes"
      ],
      "title": "MarketInterval",
      "type": "object"
    },
    "PlotlyFigure": {
      "additionalProperties": false,
      "description": "Plotly's extensible JSON figure; Plotly validates its trace/layout schemas.",
      "properties": {
        "data": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Data",
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/PlotlyLayout"
        }
      },
      "required": [
        "data",
        "layout"
      ],
      "title": "PlotlyFigure",
      "type": "object"
    },
    "PlotlyLayout": {
      "additionalProperties": true,
      "description": "A map layout with Plotly-owned extensions and an explicit camera object.",
      "properties": {
        "mapbox": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Mapbox",
          "type": "object"
        },
        "uirevision": {
          "title": "Uirevision",
          "type": "string"
        }
      },
      "required": [
        "mapbox",
        "uirevision"
      ],
      "title": "PlotlyLayout",
      "type": "object"
    },
    "ViewRequest": {
      "additionalProperties": false,
      "description": "One explicit market-day view; selection is a published row identifier.",
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "interval": {
          "minimum": 0,
          "title": "Interval",
          "type": "integer"
        },
        "selected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected"
        },
        "reference": {
          "anyOf": [
            {
              "enum": [
                "AT",
                "BE",
                "CZ",
                "DE",
                "FR",
                "HR",
                "HU",
                "NL",
                "PL",
                "RO",
                "SI",
                "SK"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "required": [
        "day",
        "interval",
        "selected"
      ],
      "title": "ViewRequest",
      "type": "object"
    },
    "ZoneGeometry": {
      "additionalProperties": false,
      "description": "Display boundary and interior label anchor shared by every interval.",
      "properties": {
        "zone": {
          "enum": [
            "AT",
            "BE",
            "CZ",
            "DE",
            "FR",
            "HR",
            "HU",
            "NL",
            "PL",
            "RO",
            "SI",
            "SK"
          ],
          "title": "Zone",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rings": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "title": "Rings",
          "type": "array"
        },
        "centre": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Centre",
          "type": "array"
        }
      },
      "required": [
        "zone",
        "name",
        "rings",
        "centre"
      ],
      "title": "ZoneGeometry",
      "type": "object"
    }
  },
  "properties": {
    "bundle": {
      "$ref": "#/$defs/DayBundle"
    },
    "manifest": {
      "$ref": "#/$defs/DayManifest"
    },
    "day": {
      "$ref": "#/$defs/DayResponse"
    },
    "layer": {
      "$ref": "#/$defs/LayerResponse"
    },
    "attribution": {
      "$ref": "#/$defs/AttributionPayload"
    },
    "error": {
      "$ref": "#/$defs/ApiError"
    }
  },
  "required": [
    "bundle",
    "manifest",
    "day",
    "layer",
    "attribution",
    "error"
  ],
  "title": "CnecContracts",
  "type": "object"
}
